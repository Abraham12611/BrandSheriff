# Clerk React SDK publishable key (public; safe to commit in .env.local but NOT a secret).
VITE_CLERK_PUBLISHABLE_KEY=

# Convex/Clerk auth configuration. Set this on the Convex deployment, not in .env.local:
#   npx convex env set CLERK_FRONTEND_API_URL "https://your-clerk-instance.clerk.accounts.dev"
CLERK_FRONTEND_API_URL=
